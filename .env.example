# Copy to .env.local and fill in to enable tier 4 (LLM adjudication).
# Without this, the app runs fully — tier 4 is skipped and reported honestly
# as "skipped_no_key" rather than faked.

# Groq API key (free tier). Get one at https://console.groq.com/keys
# Targets openai/gpt-oss-120b — NOT llama-3.3-70b-versatile, which Groq's own
# docs list for migration. Free-tier rate limits change often; re-verify
# before a demo.
GROQ_API_KEY=

# Slack incoming webhook (optional). Enables slack.notify — a run-finished /
# new-exception ping. Without this, the tool reports "unconfigured" honestly
# rather than pretending to post. Create one at
# https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Razorpay test-mode API keys (optional). Enables razorpay.settlements.list —
# pulls real settlement batches from your own test-mode account. Get a
# key pair from the Razorpay Dashboard (Settings -> API Keys), test mode.
# Without these, the tool reports "unconfigured" — there is no fixture
# fallback for this one (see lib/tools/actions/razorpay.ts for why).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
